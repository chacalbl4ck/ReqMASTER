<IfModule mod_rewrite.c>
    RewriteEngine On

    # Não reescrever requisições que já apontam para public/ ou install/
    RewriteRule ^public(/.*)?$ - [L]
    RewriteRule ^install(/.*)?$ - [L]

    # Redireciona demais requisições (incluindo raiz em subpastas) para public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
